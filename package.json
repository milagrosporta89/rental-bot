{
  "name": "rental-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para gestión de alquileres temporarios",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --max-old-space-size=4096\" ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/express": "^5.0.6",
    "axios": "^1.15.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.7",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
